	"animatium.persistentBlockOutline": "[1.7] Always Show Block Outline",
	"animatium.persistentBlockOutline.description": "Enable/disable showing the block outline in all gamemodes, like it was in <=1.7.x.",
	"animatium.fastGrass": "[1.7-fast] Fast Grass",
	"animatium.fastGrass.description": "Brings back the non-biome-tinted grass side texture from <=1.7.x.",
	"animatium.oldY0Height": "[1.16] Old Y0 Height",
	"animatium.oldY0Height.description": "Changes the minY of the world back to 0 like it was in <=1.16.5.",
	"animatium.oldWaterOverlayOpacity": "[1.12.2] Old Water Overlay Opacity",
	"animatium.oldWaterOverlayOpacity.description": "Changes the water texture overlay opacity to 0.5 like it was in <=1.12.2.\n\nThis is when you are submerged in water.",
	"animatium.oldWaterColorFog": "[1.12.2] Old Water Color Fog",
	"animatium.oldWaterColorFog.description": "Restores the old water fog-color calculation from <=1.12.x",
	"animatium.disableRandomBlockRotations": "[1.7] Disable Random Block Rotations",
	"animatium.disableRandomBlockRotations.description": "Enable/disable random block model rotations like in <=1.7.x.",
	"animatium.legacyDiffuseLighting": "[1.15.2] Legacy Diffuse Lighting",
	"animatium.legacyDiffuseLighting.description": "Use the default diffuse lighting vectors for everything like it was in <=1.15.2.",
	"animatium.legacyLightmap": "[1.12.2] Legacy Lightmap",
	"animatium.legacyLightmap.description": "",
	"animatium.legacyFogDarkness": "[1.13.1] Legacy Fog Darkness",
	"animatium.legacyFogDarkness.description": "",
	"animatium.legacySplashPosition": "[1.12.2] Legacy Splash Position",
	"animatium.legacySplashPosition.description": "",

	"animatium.category.extras": "Extras",
	"animatium.minimalViewBobbing": "[*] Minimal View Bobbing",
	"animatium.minimalViewBobbing.description": "Removes the view bobbing from tilting the world.",
	"animatium.showNameTagInThirdPerson": "[*] Show Nametag In Third-Person",
	"animatium.showNameTagInThirdPerson.description": "Enable/disable visibility of the player nametag whilst in third-person.",
	"animatium.hideNameTagBackground": "[*] Hide Name-Tag Background",
	"animatium.hideNameTagBackground.description": "Enable/disable the nametag background.",
	"animatium.nameTagTextShadow": "[*] Apply Text Shadow On Name-Tag",
	"animatium.nameTagTextShadow.description": "Make the nametag use text shadow.",
	"animatium.debugHudTextColor": "[1.7] Debug Hud Text Color",
	"animatium.debugHudTextColor.description": "Makes the debug hud text color white again.",
	"animatium.alwaysSharpParticles": "[*] Always Show Sharp Particles On Damage",
	"animatium.alwaysSharpParticles.description": "Always show the sharpness particles when damaging/hitting an entity.",
	"animatium.disableRecipeAndTutorialToasts": "[*] Disable Recipe And Tutorial Toasts",
	"animatium.disableRecipeAndTutorialToasts.description": "Enable/disable the annoying tutorial and recipe unload toasts & sound.",
	"animatium.showArmWhileInvisible": "[*] Show arm whilst invisible",
	"animatium.showArmWhileInvisible.description": "Shows the arm as partially visible whilst invisible, like spectator mode or invisibly effect.",
	"animatium.dontMoveBlueVoid": "[*] Don't move blue void sky",
	"animatium.dontMoveBlueVoid.description": "Stops the blue void sky from moving based on eye height.\n\nRequires blueVoidSky to be enabled.",
	"animatium.usageSwingingParticles": "[*] Show particles during usage swinging",
	"animatium.usageSwingingParticles.description": "Shows fake block-breaking particles during usage swinging to match <=1.7.x.",
	"animatium.disableEntityDeathTopple": "[*] Disable entity death rotation",
	"animatium.disableEntityDeathTopple.description": "Enable/disable the dying entity from rotating 90 degrees.",
	"animatium.disableParticlePhysics": "[*] Disable Particle Physics",
	"animatium.disableParticlePhysics.description": "Enable/disable particles ability to bypass collision logic.",
	"animatium.disableFirstPersonParticles": "[*] Disable First-Person particles",
	"animatium.disableFirstPersonParticles.description": "Enable/disable potion particle effects coming from you whilst in first-person.",
	"animatium.dontClearChat": "[*] Don't Clear Chat",
	"animatium.dontClearChat.description": "Stops minecraft from clearing chat.",
	"animatium.dontCloseChat": "[*] Don't Close Chat",
	"animatium.dontCloseChat.description": "Stops minecraft from closing the chat screen on teleport/some situations.",
	"animatium.oldWaterColorEffects": "[1.12.2] Old Water Color Effects",
	"animatium.oldWaterColorEffects.description": "Forces watercolor in biomes to be what it was in <=1.12.2.\n\nREQUIRES RESOURCE PACK",
	"animatium.colorBoost": "[*] Color/Saturation Boost",
	"animatium.colorBoost.description": "Applies a colorboost/saturation boost to the games overall look.",
	"animatium.alwaysBlockingHeadCap": "[*] Always Blocking Head Cap",
	"animatium.alwaysBlockingHeadCap.description": "Always caps the head rotation relative to the body of the model to that of when blocking.\n\nNOTE: Requires \"[1.20.1] Reverts head rotation whilst blocking\" (in Movement category) to be turned off.",
	"animatium.hideRecipeBook": "[1.11] Hide Recipe Book",
	"animatium.hideRecipeBook.description": "Hides the recipe book from the inventory, including the button.",
	"animatium.legacyLoadingScreenProgressBar": "[*] Legacy Loading Screen Progress Bar",
	"animatium.legacyLoadingScreenProgressBar.description": "Re-enable the loading screen progress bar when the \"Legacy Loading Screen\" setting is enabled.",
	"animatium.damageBloodParticles": "[*] Blood Particles On Hit",
	"animatium.damageBloodParticles.description": "Shows redstone-like particles when hitting entities.\n\nCredit to Orange Marshalls \"Vanilla Enhancements\" mod from 1.8.",
	"animatium.bloodParticleMultiplier": "[*] Blood Particles Multiplier",
	"animatium.bloodParticleMultiplier.description": "Multiplies the amount of blood particles that appear. (Calculation is 5 * value)",

	"animatium.category.extras.group.damage_tint": "Damage Tint",
	"animatium.damageTintItems": "[*] Damage Tint Items",
	"animatium.damageTintItems.description": "Applies the damage hurt tint to your currently held item in first/third person.",
	"animatium.damageTintCape": "[*] Damage Tint Cape",
	"animatium.damageTintCape.description": "Applies the damage hurt tint to capes.",

	"animatium.category.extras.group.item_swing": "Item Swing",
	"animatium.customSwingSpeed": "Enable Custom Swing Speed",
	"animatium.customSwingSpeed.description": "Enable/disable these options from affecting the game.",
	"animatium.itemSwingSpeed": "Item Swing Speed",
	"animatium.itemSwingSpeed.description": "Modify the held item/hand swing speed visually.",
	"animatium.hasteSwingSpeed": "Haste Swing Speed",
	"animatium.hasteSwingSpeed.description": "Modify the held item/hand swing speed visually when you have haste.",
	"animatium.miningFatigueSwingSpeed": "Mining Fatigue Swing Speed",
	"animatium.miningFatigueSwingSpeed.description": "Modify the held item/hand swing speed visually when you have mining fatigue.",
	"animatium.ignoreHasteSpeed": "Ignore Haste Speed",
	"animatium.ignoreHasteSpeed.description": "Ignore the haste speed modifier during item/hand swing.",
	"animatium.ignoreMiningFatigueSpeed": "Ignore Mining Fatigue Speed",
	"animatium.ignoreMiningFatigueSpeed.description": "Ignore the mining fatigue speed modifier during item/hand swing.",
	"animatium.offhandUsageSwinging": "Allow Off-Hand Usage Swinging",
	"animatium.offhandUsageSwinging.description": "Swings the offhand whilst using item and holding right click.",
	"animatium.alwaysUsageSwing": "Allow Usage Swinging Always",
	"animatium.alwaysUsageSwing.description": "Allows you to swing/use the item in the air/always.",
	"animatium.fakeMissPenaltySwing": "Swing During Missed Hit",
	"animatium.fakeMissPenaltySwing.description": "In vanilla Minecraft, if the player has missed their hit, there will be a 10 ms delay on top of the attack cooldown before they can swing again. Enable this feature to play a fake swing animation during that 10 ms delay to match <=1.7.x.",
	"animatium.disableSwingTranslate": "Disable Swing Translate",
	"animatium.disableSwingTranslate.description": "Removes the translation/offset when swinging your item.",
	"animatium.disableSwingPivot": "Disable Swing Pivot",
	"animatium.disableSwingPivot.description": "Removes the pivot when swinging your item.",
	"animatium.legacySwingAnimation": "Legacy Swing",
	"animatium.legacySwingAnimation.description": "Removes the 1.9+ cooldown animation when swinging your item, making it look like <=1.8.",

