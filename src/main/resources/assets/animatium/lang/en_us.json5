	"animatium.disableCameraTransparentPassthrough.description": "Disable camera passthrough in third-person in glass/etc like in <=1.15.",
	"animatium.tooltipStyleRendering": "[1.20] Restore Old Tooltip Style",
	"animatium.tooltipStyleRendering.description": "Restores the corners of the tooltip texture that were removed in 1.21.2.\n\nNOTE: If you are using a resource pack with a custom tooltip texture, turn this setting OFF to not cause issues!",
	"animatium.slotHoverStyleRendering": "[1.20] Restore Legacy Inventory Slot Hover",
	"animatium.slotHoverStyleRendering.description": "Restores the old inventory slot hover visual to how it was prior to 1.21.2.\n\nNOTE: If you are using a resource pack with a custom slot hover texture, turn this setting OFF to not cause issues!",
	"animatium.listBackgroundGradient": "[1.20.4] Restore List Background Gradient",
	"animatium.listBackgroundGradient.description": "Restores the old list widget background gradient from <=1.20.4.",
	"animatium.inventoryEffectsPosition": "[1.11] Inventory Status-Effects Position",
	"animatium.inventoryEffectsPosition.description": "Restores the old potion effects status position in the inventory to like it was in <=1.11/1.19.",
	"animatium.fullWidthInventoryEffects": "[1.21.10] Full Width Inventory Status-Effects Background",
	"animatium.fullWidthInventoryEffects.description": "Restores the old inventory status-effects background width from <=1.21.10.",
	"animatium.panoramaRendering": "§6[1.12.2] Legacy Panorama Rendering",
	"animatium.panoramaRendering.description": "Restores the legacy way of rendering the panorama in the main menu like in 1.12.2 and below.\n\nNOTE: This replaces the panorama rendering including the resource pack overlay texture!",
	"animatium.legacyLoadingScreen": "[1.13] Legacy Loading Screen",
	"animatium.legacyLoadingScreen.description": "Restores the classic legacy reloading/loading screen from <=1.13.",
	"animatium.oldChatPosition": "[1.11] Legacy Chat Position",
	"animatium.oldChatPosition.description": "Restores the legacy chat position from <=1.11.",
	"animatium.oldCrosshairPosition": "[1.13] Legacy Crosshair Position",
	"animatium.oldCrosshairPosition.description": "Offsets the crosshair by 1px so that the position matches what it was in <=1.13.",
	"animatium.disconnectServerToTitleScreen": "[1.7] Disconnect To Title Screen",
	"animatium.disconnectServerToTitleScreen.description": "Reintroduces a bug from <=1.7.x where it would send you to the title screen when you disconnect from a server.",
	"animatium.oldCraftingSlotsPosition": "[1.8] Legacy Crafting Slots Position",
	"animatium.oldCraftingSlotsPosition.description": "Moves the craft slots down and to the left to match how it was in <=1.8.x. Also puts the offhand slot in a better position to accommodate this change.",

