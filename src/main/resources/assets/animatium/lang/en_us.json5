	"animatium.glintOnItemDrops2D.description": "Disables the enchantment glint on dropped items.\n\nNOTE: Intended to be used along side the 2D dropped items feature to match <1.7.x.",
	"animatium.glintOnItemFramed2D": "§6[1.7] Toggle glint on framed items",
	"animatium.glintOnItemFramed2D.description": "Disables the enchantment glint on framed items.\n\nNOTE: Intended to be used along side the 2D framed items feature to match <1.7.x.",
	"animatium.category.items.group.drops2d": "2D Drops",
	"animatium.itemDropsFaceCamera": "[1.7-fast] Make item entities use camera yaw / face camera",
	"animatium.itemDropsFaceCamera.description": "Makes item entities face the camera / use camera yaw like <=1.7.x when fast graphics.",
	"animatium.itemDropsFaceCameraRotationFix": "[*] Fixes 2D item drops rotation",
	"animatium.itemDropsFaceCameraRotationFix.description": "Makes 2D item drops also face the camera pitch.\n\nTurn this off if you want it to be like 1.7.\n\nRequires the above setting to be enabled.",
