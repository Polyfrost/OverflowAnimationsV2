	"animatium.longUnsneak": "[1.7] Long Un-Sneak Animation",
	"animatium.longUnsneak.description": "Makes the sneak animation take longer when un-sneaking like it was in 1.7.",
	"animatium.fakeOldSneakEyeHeight": "§6[1.13] Fake Sneaking Eye Height",
	"animatium.fakeOldSneakEyeHeight.description": "Changes the sneak eye height to be as it was in <=1.13.2 visually.\n\nNOTE: This does not change your actual eye position! It is purely visual and you will still be lower game mechanics wise.",
	"animatium.rotateBackwardsWalking": "[1.11] Backwards Walking Rotation",
	"animatium.rotateBackwardsWalking.description": "Rotates the entity body sideways when walking backwards like it was in <=1.11.2.",
	"animatium.uncapBlockingHeadRotation": "[1.20.1] Revert Head Rotation (Blocking)",
	"animatium.uncapBlockingHeadRotation.description": " Reverts the change in 1.20.2, making head rotation when blocking as it used to be.",
	"animatium.disableHeadRotationInterpolation": "[1.7] Disable Head Rotation Interpolation",
	"animatium.disableHeadRotationInterpolation.description": "Enable/disable the head rotation interpolation like in <=1.7.",
	"animatium.handViewBobbingMovement": "[1.20] Legacy Hand bobbing",
	"animatium.handViewBobbingMovement.description": "Undoes the 1.21.2+ view bobbing change where when sneaking, your hand still moves normally.",
	"animatium.deathLimbs": "[*] Old Death Limbs",
	"animatium.deathLimbs.description": "Makes entities continue their animation even upon death.",
	"animatium.bowArmMovement": "[1.7?] Legacy Third-Person Arm Bow Movement",
	"animatium.bowArmMovement.description": "Restores old player body movement in third-person when using the bow like in <=1.7?",
	"animatium.legacyDamageTilt": "[1.19] Legacy Damage Tilt",
	"animatium.legacyDamageTilt.description": "Reverts the damage tilt to it's old logic which will tilt in one direction like in <=1.19.4.",
  	"animatium.offsetHurtTiltTime": "[1.7] Offset Hurt Tilt Time",
	"animatium.offsetHurtTiltTime.description": "Offsets the damage tilt time by -1 like in <=1.7.x.",
	"animatium.category.movement.group.cape": "Cape",
	"animatium.oldCapeMovement": "[1.12.2] Old Cape Movement",
	"animatium.oldCapeMovement.description": "Changes the cape model movement to be how it used to be in <=1.12.x.",
	"animatium.disableCapeLean": "[OF] Disable Cape Lean",
	"animatium.disableCapeLean.description": "Enable/disable the cape lean. Turning this on will match OptiFine cape physics.",
	"animatium.disableCapeSwingRotation": "[1.20] Disable Cape Movement Whilst Swinging Arm",
	"animatium.disableCapeSwingRotation.description": "Disables the cape from swinging in unison with the body while the player is swinging their arm like it was in <=1.20.x.",
	"animatium.capeChestplateTranslation": "[1.7] Don't Move Cape While Chestplate Is Equipped",
	"animatium.capeChestplateTranslation.description": "Stops equipping a chestplate causing the cape to be translated a few pixels away like in <=1.15.x",
	"animatium.capeSneakPosition": "[1.7] Cape Sneaking Position",
	"animatium.capeSneakPosition.description": "Positions the cape while sneaking similarly to <=1.7.x",

