	"animatium.disableSwingOnEntityInteract.description": "Disables the swing animation when interacting with interactable entities such as villagers matching how it was in <=1.14.x.",
	"animatium.disableItemUsingTextureInGUI": "[1.8] Disable Item Usage Texture in GUI",
	"animatium.disableItemUsingTextureInGUI.description": "Disables the item usage texture in the GUI which restores it to be like in <=1.8.x (mainly rod/bow/crossbow).",
	"animatium.equipAnimationVersion": "[*] Legacy Equip Animation",
