{
	"overflowanimations.title": "OverflowAnimations Config",

	"overflowanimations.category.movement": "Movement",
	"overflowanimations.category.movement.group.other": "Other",
	"overflowanimations.sneakAnimation": "[*] Change sneak animation to be like it was in",
	"overflowanimations.sneakAnimation.description": "Changes the visual sneaking animation aspects to act like it was in the selected version.",
	"overflowanimations.enum.SneakAnimationSetting.V1_14": "1.14+",
	"overflowanimations.enum.SneakAnimationSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.SneakAnimationSetting.V1_13": "1.13",
	"overflowanimations.enum.SneakAnimationSetting.V1_8": "1.8",
	"overflowanimations.enum.SneakAnimationSetting.V1_7": "1.7 and below",
	"overflowanimations.longUnsneak": "[1.7] Long Un-Sneak Animation",
	"overflowanimations.longUnsneak.description": "Makes standing up from a sneak glide like it did in 1.7. Works with every sneak animation except 1.8.",
	"overflowanimations.longUnsneakLegacyOnly": "Long Un-Sneak on 1.8.9 Only",
	"overflowanimations.longUnsneakLegacyOnly.description": "Only applies Long Un-Sneak Animation when playing on 1.8.9. Useful when sharing one config between 1.8.9 and newer versions.",
	"overflowanimations.sneakEyeHeight": "[*] Sneak Eye Height",
	"overflowanimations.sneakEyeHeight.description": "1.8: The camera only lowers slightly while sneaking.\n1.14: The camera lowers to the 1.14+ sneaking eye height.\n\nNOTE: This is purely visual and does not change your actual eye position.",
	"overflowanimations.enum.SneakEyeHeightSetting.V1_8": "1.8",
	"overflowanimations.enum.SneakEyeHeightSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.SneakEyeHeightSetting.V1_14": "1.14+",
	"overflowanimations.backwardsWalking": "[*] Backwards Walking",
	"overflowanimations.backwardsWalking.description": "1.8: The body turns sideways when walking backwards.\n1.12: The body keeps facing forward when walking backwards.",
	"overflowanimations.enum.BackwardsWalkingSetting.V1_8": "1.8",
	"overflowanimations.enum.BackwardsWalkingSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.BackwardsWalkingSetting.V1_12": "1.12+",
	"overflowanimations.uncapBlockingHeadRotation": "[1.20.1] Revert Head Rotation (Blocking)",
	"overflowanimations.uncapBlockingHeadRotation.description": " Reverts the change in 1.20.2, making head rotation when blocking as it used to be.",
	"overflowanimations.headRotationInterpolation": "[*] Head Rotation Interpolation",
	"overflowanimations.headRotationInterpolation.description": "1.8: Head rotation of other players and mobs snaps to each server update.\n1.13: Head rotation is smoothed between server updates.",
	"overflowanimations.enum.HeadRotationInterpolationSetting.V1_8": "1.8",
	"overflowanimations.enum.HeadRotationInterpolationSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.HeadRotationInterpolationSetting.V1_13": "1.13+",
	"overflowanimations.sneakBobbing": "[*] Change sneak bobbing to be like it was in",
	"overflowanimations.sneakBobbing.description": "In 1.21.1 and below, view bobbing stops while sneaking. In 1.21.2+, it keeps going at sneaking speed.",
	"overflowanimations.enum.SneakBobbingSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.SneakBobbingSetting.V1_21_2": "1.21.2+",
	"overflowanimations.enum.SneakBobbingSetting.V1_21_1": "1.21.1 and below",
	"overflowanimations.deathLimbs": "[*] Old Death Limbs",
	"overflowanimations.deathLimbs.description": "Makes entities continue their animation even upon death.",
	"overflowanimations.bowArmMovement": "[1.7?] Legacy Third-Person Arm Bow Movement",
	"overflowanimations.bowArmMovement.description": "Restores old player body movement in third-person when using the bow like in <=1.7?",
	"overflowanimations.damageTilt": "[*] Damage Tilt",
	"overflowanimations.damageTilt.description": "1.8: The camera always tilts the same way when you take damage.\n1.19.4: The camera tilts away from where the damage came from.",
	"overflowanimations.enum.DamageTiltSetting.V1_8": "1.8",
	"overflowanimations.enum.DamageTiltSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.DamageTiltSetting.V1_19_4": "1.19.4+",
  	"overflowanimations.offsetHurtTiltTime": "[1.7] Offset Hurt Tilt Time",
	"overflowanimations.offsetHurtTiltTime.description": "Offsets the damage tilt time by -1 like in <=1.7.x.",
	"overflowanimations.slimArmPosition": "[*] Slim Arm Position",
	"overflowanimations.slimArmPosition.description": "1.8: Slim (Alex) arms sit half a pixel lower than wide arms.\n1.15: Slim arms sit at the same height as wide arms.\nReload resources (F3+T) to apply. 1.8.9 needs a restart.",
	"overflowanimations.enum.SlimArmPositionSetting.V1_8": "1.8",
	"overflowanimations.enum.SlimArmPositionSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.SlimArmPositionSetting.V1_15": "1.15+",
	"overflowanimations.category.movement.group.cape": "Cape",
	"overflowanimations.capeMovement": "[*] Cape Movement",
	"overflowanimations.capeMovement.description": "Changes the cape movement to be as it was in said version. 1.12 and below doesn't wrap body rotation, so the cape can spin around, and doesn't limit the sideways lean.",
	"overflowanimations.enum.CapeMovementSetting.V1_12": "1.12 and below",
	"overflowanimations.enum.CapeMovementSetting.V1_13": "1.13+",
	"overflowanimations.disableCapeLean": "[OF] Disable Cape Lean",
	"overflowanimations.disableCapeLean.description": "Enable/disable the cape lean. Turning this on will match OptiFine cape physics.",
	"overflowanimations.disableCapeSwingRotation": "[1.20] Disable Cape Movement Whilst Swinging Arm",
	"overflowanimations.disableCapeSwingRotation.description": "Disables the cape from swinging in unison with the body while the player is swinging their arm like it was in <=1.20.x.",
	"overflowanimations.capeChestplateTranslation": "[1.7] Don't Move Cape While Chestplate Is Equipped",
	"overflowanimations.capeChestplateTranslation.description": "Stops equipping a chestplate causing the cape to be translated a few pixels away like in <=1.15.x",
	"overflowanimations.capeSneakPosition": "[1.7] Cape Sneaking Position",
	"overflowanimations.capeSneakPosition.description": "Positions the cape while sneaking similarly to <=1.7.x",

