	"overflowanimations.enum.ItemGlintSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.ItemGlintSetting.V1_15": "1.15+",
	"overflowanimations.armorGlint": "Armor Glint Version",
	"overflowanimations.armorGlint.description": "Changes how the enchantment glint looks on armor.\n\n1.8: Two purple glint layers crossing at ±30°.\n1.15: The item glint texture at full speed and strength.\n1.19.4: The darker modern armor glint.",
	"overflowanimations.enum.ArmorGlintSetting.V1_8": "1.8",
	"overflowanimations.enum.ArmorGlintSetting.V1_15": "1.15",
	"overflowanimations.enum.ArmorGlintSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.ArmorGlintSetting.V1_19_4": "1.19.4+",
	"overflowanimations.potionGlint": "Potion Glint Version",
	"overflowanimations.potionGlint.description": "Changes the enchantment glint on potions.\n\n1.7: Only the colored part of the potion glints. On modern versions, same as 1.8.\n1.8: Potions with effects glint.\n1.19.4: Potions never glint.",
	"overflowanimations.enum.PotionGlintSetting.V1_7": "1.7",
	"overflowanimations.enum.PotionGlintSetting.V1_8": "1.8",
	"overflowanimations.enum.PotionGlintSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.PotionGlintSetting.V1_19_4": "1.19.4+",
	"overflowanimations.glintOnItemDrops2D": "[1.7] Glint on 2D Dropped Items",
	"overflowanimations.glintOnItemDrops2D.description": "Shows the enchantment glint on 2D dropped items.\n\nNOTE: Leave off to match <1.7.x.",
	"overflowanimations.glintOnItemFramed2D": "[1.7] Glint on 2D Framed Items",
	"overflowanimations.glintOnItemFramed2D.description": "Shows the enchantment glint on 2D framed items.\n\nNOTE: Leave off to match <1.7.x.",
	"overflowanimations.category.items.group.drops2d": "2D Drops",
	"overflowanimations.itemDropsFaceCamera": "[1.7-fast] Make item entities use camera yaw / face camera",
	"overflowanimations.itemDropsFaceCamera.description": "Makes item entities face the camera / use camera yaw like <=1.7.x when fast graphics.",
	"overflowanimations.itemDropsFaceCameraRotationFix": "[*] Fixes 2D item drops rotation",
	"overflowanimations.itemDropsFaceCameraRotationFix.description": "Makes 2D item drops also face the camera pitch.\n\nTurn this off if you want it to be like 1.7.\n\nRequires the above setting to be enabled.",
	"overflowanimations.itemDrops2D": "[1.7] Make item entities 2D when dropped",
	"overflowanimations.itemDrops2D.description": "Makes item entities render 2D when it's an item (not blocks).",
	"overflowanimations.itemFramed2D": "[1.7] Make framed items 2D",
	"overflowanimations.itemFramed2D.description": "Makes framed items render 2D (not blocks).",
