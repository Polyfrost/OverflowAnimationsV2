	"overflowanimations.lockBlockingArmRotation": "[1.19.4] Lock Third-Person Arm Blocking Rotation",
	"overflowanimations.lockBlockingArmRotation.description": "Enable/disable the third-person blocking arm rotation being locked in place.",
	"overflowanimations.legacyBlockMiningProgress": "[1.17.1] Old Block Mining Progress",
	"overflowanimations.legacyBlockMiningProgress.description": "Changes the old block mining progress texture rendering index to be like it was in <=1.17.1",
	"overflowanimations.projectileAgeCheck": "[1.14?] Projectile rendering at all ages",
	"overflowanimations.projectileAgeCheck.description": "Enable/disable the rendering of projectiles at all ages like in <=1.15?",
	"overflowanimations.blockOutlineRendering": "[1.14] Restore Legacy Block Outline Rendering",
	"overflowanimations.blockOutlineRendering.description": "Restores the legacy block outline rendering from <=1.14.4.",
	"overflowanimations.disableModelWhilstSleeping": "[1.12?] Disable Player Model While Sleeping",
	"overflowanimations.disableModelWhilstSleeping.description": "Disables the player model rendering whilst sleeping like in <=1.12? Only affects you.",
	"overflowanimations.flameDimensions": "[1.12.2] Legacy Third-Person Flame Dimensions",
	"overflowanimations.flameDimensions.description": "Makes the third person flame rendering use a fixed width and height to match <=1.12.x.",
	"overflowanimations.heldItemArmLogic": "[1.8] Held Item Arm Position",
	"overflowanimations.heldItemArmLogic.description": "In 1.8, the player's arm (when viewed from the first person POV) will be positioned at an angle when holding an item. This is only truly visible when going from an empty slot to an item. This happens due it applying the held item arm rotation meant for the third person model.",
	"overflowanimations.thirdPersonSwordBlockingPosition": "[1.7] Third-person arm block animation",
	"overflowanimations.thirdPersonSwordBlockingPosition.description": "Brings back the old third-person arm blocking rotations from <=1.7.x.",
	"overflowanimations.disableInventoryEntityScissor": "[*] Disable Entity Scissor in Inventory",
	"overflowanimations.disableInventoryEntityScissor.description": "Enable/disable allowing the inventory entity model to render fully.",
	"overflowanimations.itemGlintOnEntity": "[*] Force Item Glint On Armor",
	"overflowanimations.itemGlintOnEntity.description": "Forces the glint on armor to use the item glint texture. This therefore unifies the glint texture like in older mc versions.",
	"overflowanimations.maxGlintProperties": "[*] Force Max Glint Speed/Strength",
	"overflowanimations.maxGlintProperties.description": "Forces the glint to use the maximum speed and strength by default like in older mc versions.",
	"overflowanimations.flameOffset": "[1.7] Offset Third-Person Flame Rendering",
	"overflowanimations.flameOffset.description": "Brings back the third person flame offset from <=1.7.x.",
	"overflowanimations.persistentBlockOutline": "[1.7] Always Show Block Outline",
	"overflowanimations.persistentBlockOutline.description": "Enable/disable showing the block outline in all gamemodes, like it was in <=1.7.x.",
	"overflowanimations.fastGrass": "[1.7-fast] Fast Grass",
	"overflowanimations.fastGrass.description": "Brings back the non-biome-tinted grass side texture from <=1.7.x.",
	"overflowanimations.oldY0Height": "[1.16] Old Y0 Height",
	"overflowanimations.oldY0Height.description": "Changes the minY of the world back to 0 like it was in <=1.16.5.",
	"overflowanimations.oldWaterOverlayOpacity": "[1.12.2] Old Water Overlay Opacity",
