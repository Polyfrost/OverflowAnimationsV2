	"overflowanimations.fixOffHandUsingPose": "[1.17] Fix Offhand Pose Whilst Using An Item",
	"overflowanimations.fixOffHandUsingPose.description": "Stops the offhand from using the NONE pose with a held item while using an item in the mainhand like in <=1.17.",
	"overflowanimations.fixCastLineCheck": "[MC-109263] Fix Arm-Related Fishing Rod Cast Line Check",
	"overflowanimations.fixCastLineCheck.description": "Fixes the arm logic for casting the fishing rod.",
	"overflowanimations.fixCastLineSwing": "[*] Fix Left-Handed Fishing Rod Swing",
	"overflowanimations.fixCastLineSwing.description": "Fixes the swing logic for casting the fishing rod.",
	"overflowanimations.fixFireballClientsideVisual": "[1.13] Fix Fireball Clientside Fire",
	"overflowanimations.fixFireballClientsideVisual.description": "Makes fire charges not place fire clientside like in older mc versions. Doesn't cause issues on servers, and is clientside only.",
	"overflowanimations.fixTextStrikethroughStyle": "[1.12.2] Fix Text Strikethrough Style",
	"overflowanimations.fixTextStrikethroughStyle.description": "Changes the text strikethrough position to make it look like it did in <=1.12.2.",
	"overflowanimations.fixHighAttackSpeedIndicator": "[*] Fix High Attack Speed Crosshair Indicator",
	"overflowanimations.fixHighAttackSpeedIndicator.description": "Hides the attack indicator when you have such a high attack speed. (Fixes MC-268420)",
	"overflowanimations.viewBobbingTilt": "[*] View Bobbing Tilt",
	"overflowanimations.viewBobbingTilt.description": "1.8: The camera tilts while falling or flying up.\n1.14: The camera does not tilt while falling or flying up. (MC-225335)",
	"overflowanimations.enum.ViewBobbingTiltSetting.V1_8": "1.8",
	"overflowanimations.enum.ViewBobbingTiltSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.ViewBobbingTiltSetting.V1_14": "1.14+",
	"overflowanimations.upMinPixelTransparencyLimit": "[*] Up Min Pixel Transparency Limit",
	"overflowanimations.upMinPixelTransparencyLimit.description": "Makes the minimum 0-transparency value less than or equal to 0.1. This fixes textures with invisible pixels that cause issues.",
	"overflowanimations.useEquipAnimation": "[*] Item Use Equip Animation",
	"overflowanimations.useEquipAnimation.description": "1.8: Using an item (blocking, eating, drawing a bow, etc.) does not play the equip animation.\n1.9: Using an item plays the equip animation.",
	"overflowanimations.enum.UseEquipAnimationSetting.V1_8": "1.8",
	"overflowanimations.enum.UseEquipAnimationSetting.VANILLA": "Vanilla",
	"overflowanimations.enum.UseEquipAnimationSetting.V1_9": "1.9+",
	"overflowanimations.fixItemUsageVisualInGUI": "[*] Fix Item Usage Visual Whilst In GUI",
	"overflowanimations.fixItemUsageVisualInGUI.description": "Enable/disable item usage animation whilst inside a GUI, for example the continuous visual blocking, etc.",
	"overflowanimations.fixDoubleUsageVisual": "[*] Fix Double Item Usage Visual",
	"overflowanimations.fixDoubleUsageVisual.description": "Fixes the double item usage issue on servers, usually found when you have high ping.",
	"overflowanimations.oldSkyRenderingCheck": "[*] Sky Rendering Check",
	"overflowanimations.oldSkyRenderingCheck.description": "Brings back the old render distance check for sky rendering, making it not render in <=4 render distance.",
