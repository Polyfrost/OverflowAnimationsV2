	"overflowanimations.disableHeartFlash": "[1.7] Disable Heart Flashing",
	"overflowanimations.disableHeartFlash.description": "Makes the hearts blink like they did in 1.7, only briefly after taking damage instead of after every health change.",
	"overflowanimations.centerScrollableListWidgets": "[1.7] Center Scrollable List Widgets",
	"overflowanimations.centerScrollableListWidgets.description": "Center scrollable list widgets like <=1.7.x.",
	"overflowanimations.listWidgetSelectedBorderColor": "[1.15] Legacy List Widget Selected Border Color",
	"overflowanimations.listWidgetSelectedBorderColor.description": "Returns the old list widget selected border color from <=1.15?",
	"overflowanimations.legacyWidgetHoverTextColor": "[1.14] Old Widget Hover Text Colors",
	"overflowanimations.legacyWidgetHoverTextColor.description": "Bring back the old yellow hover/grayish text colors like in <=1.14.4.",
	"overflowanimations.disableDebugHudBackground": "[1.7] Disable F3 Debug Hud Background",
	"overflowanimations.disableDebugHudBackground.description": "Enable/disable the F3 Debug Hud background like it was in <=1.7,",
	"overflowanimations.debugHudTextShadow": "[1.7] Enable F3 Debug Hud Text-Shadow",
	"overflowanimations.debugHudTextShadow.description": "Enable/disable f3 debug hud text-shadow like it was in <=1.7.x.",
	"overflowanimations.disableCameraTransparentPassthrough": "[1.15] Disable Third-Person Camera Block Passthrough",
	"overflowanimations.disableCameraTransparentPassthrough.description": "Disable camera passthrough in third-person in glass/etc like in <=1.15.",
	"overflowanimations.tooltipStyleRendering": "[1.20] Restore Old Tooltip Style",
	"overflowanimations.tooltipStyleRendering.description": "Restores the corners of the tooltip texture that were removed in 1.21.2.\n\nNOTE: If you are using a resource pack with a custom tooltip texture, turn this setting OFF to not cause issues!",
	"overflowanimations.slotHoverStyleRendering": "[1.20] Restore Legacy Inventory Slot Hover",
	"overflowanimations.slotHoverStyleRendering.description": "Restores the old inventory slot hover visual to how it was prior to 1.21.2.\n\nNOTE: If you are using a resource pack with a custom slot hover texture, turn this setting OFF to not cause issues!",
	"overflowanimations.listBackgroundGradient": "[1.20.4] Restore List Background Gradient",
	"overflowanimations.listBackgroundGradient.description": "Restores the old list widget background gradient from <=1.20.4.",
	"overflowanimations.inventoryEffectsPosition": "[1.11] Inventory Status-Effects Position",
	"overflowanimations.inventoryEffectsPosition.description": "Restores the old potion effects status position in the inventory to like it was in <=1.11/1.19.",
	"overflowanimations.fullWidthInventoryEffects": "[1.21.10] Full Width Inventory Status-Effects Background",
	"overflowanimations.fullWidthInventoryEffects.description": "Restores the old inventory status-effects background width from <=1.21.10.",
	"overflowanimations.panoramaRendering": "[1.12.2] Legacy Panorama Rendering",
	"overflowanimations.panoramaRendering.description": "Restores the legacy way of rendering the panorama in the main menu like in 1.12.2 and below.\n\nNOTE: This replaces the panorama rendering including the resource pack overlay texture!",
	"overflowanimations.legacyLoadingScreen": "[1.13] Legacy Loading Screen",
	"overflowanimations.legacyLoadingScreen.description": "Restores the classic legacy reloading/loading screen from <=1.13.",
	"overflowanimations.legacyLoadingScreenProgressBar": "[*] Legacy Loading Screen Progress Bar",
	"overflowanimations.legacyLoadingScreenProgressBar.description": "Re-enable the loading screen progress bar when the \"Legacy Loading Screen\" setting is enabled.",
	"overflowanimations.oldChatPosition": "[1.11] Legacy Chat Position",
	"overflowanimations.oldChatPosition.description": "Restores the legacy chat position from <=1.11.",
	"overflowanimations.oldCrosshairPosition": "[1.13] Legacy Crosshair Position",
	"overflowanimations.oldCrosshairPosition.description": "Offsets the crosshair by 1px so that the position matches what it was in <=1.13.",
	"overflowanimations.disconnectServerToTitleScreen": "[1.7] Disconnect To Title Screen",
	"overflowanimations.disconnectServerToTitleScreen.description": "Reintroduces a bug from <=1.7.x where it would send you to the title screen when you disconnect from a server.",
	"overflowanimations.oldCraftingSlotsPosition": "[1.8] Legacy Crafting Slots Position",
	"overflowanimations.oldCraftingSlotsPosition.description": "Moves the craft slots down and to the left to match how it was in <=1.8.x. Also puts the offhand slot in a better position to accommodate this change.",

	"overflowanimations.category.items": "Items",
	"overflowanimations.category.items.group.fishing_rod": "Fishing Rod",
	"overflowanimations.fishingRodTextureStackCheck": "[1.8] Toggle Fishing Rod Stack Texture Check",
	"overflowanimations.fishingRodTextureStackCheck.description": "Enable/disable the legacy texture check for fishing rod. Turning this on will bring back the old fishing rod stack texture check from <=1.8.",
	"overflowanimations.fishingRodLineInterpolation": "[1.13] Interpolate Fishing Line w/ Eye Height",
	"overflowanimations.fishingRodLineInterpolation.description": "Correctly interpolates the fishing rod cast line with the eye height from <1.14?",
	"overflowanimations.noMoveFishingRodLine": "[1.7] Disable Third-Person Fishing Line Movement Whilst Sneaking",
	"overflowanimations.noMoveFishingRodLine.description": "Does not move the fishing rod cast line while sneaking when viewed in the third person mode from <=1.7.x.",
	"overflowanimations.fishingRodLinePositionThirdPerson": "[1.7] Third-Person Fishing Line Position",
	"overflowanimations.fishingRodLinePositionThirdPerson.description": "Adjusts the position of the fishing rod cast line horizontally like in <=1.7.x.",
	"overflowanimations.thinFishingRodLineThickness": "[1.14?] Super Thin Fishing Line",
	"overflowanimations.thinFishingRodLineThickness.description": "Makes the fishing rod line super thin. Overrides the above setting.",
	"overflowanimations.stickModelWhenCastInThirdperson": "[1.7] Third-Person Stick Fishing Rod",
	"overflowanimations.stickModelWhenCastInThirdperson.description": "Makes the fishing rod model in third-person a stick when cast like in <=1.7.x.",
	"overflowanimations.category.items.group.glint": "Enchantment Glint",
	"overflowanimations.itemGlint": "Item Glint Version",
	"overflowanimations.itemGlint.description": "Changes how the enchantment glint looks on items, both held and in GUIs.\n\n1.7: The 1.7 glint on 1.8.9. On modern versions, the 1.8 speed.\n1.8: The 1.8 glint speed.\n1.15: The single, slower modern glint.",
	"overflowanimations.enum.ItemGlintSetting.V1_7": "1.7",
