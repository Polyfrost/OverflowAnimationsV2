	"overflowanimations.strictItemPositionsInThirdPerson.description": "Only applies the third-person held item position to 3D blocks, bows and handheld items. Everything else (ender pearls, food, buckets, ...) keeps its vanilla position.",
	"overflowanimations.thinBlockPositions": "[1.7] Held Thin Block Item Position",
	"overflowanimations.thinBlockPositions.description": "Translates the held item position of blocks like carpet/slabs/daylight sensors/pressure plates to look like how they did in <=1.7.x.",
	"overflowanimations.skullPosition": "[1.8] Held Skull Model Position",
	"overflowanimations.skullPosition.description": "Positions the skull block items' held/gui positions to be how it was in 1.8.x.",
	"overflowanimations.fishingRodVersion": "[*] Change Fishing Rod To Be Like It Was In",
	"overflowanimations.fishingRodVersion.description": "Positions the fishing rod's first-person position to be how it was in said version range.",
