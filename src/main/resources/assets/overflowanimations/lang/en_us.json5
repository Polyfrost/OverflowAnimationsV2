	"overflowanimations.itemPositions.description": "Tilts the first-person held item position to make held items look like they did in <=1.7.x.",
	"overflowanimations.itemPositionsInThirdPerson": "[1.7] Modify/Tilt The Third-Person Held Item Positions",
	"overflowanimations.itemPositionsInThirdPerson.description": "Tilts the third-person held item position to make held items look like they did in <=1.7.x.",
