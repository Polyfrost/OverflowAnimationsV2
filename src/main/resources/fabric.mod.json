{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"Mixces",
		"lowercasebtw"
	],
	"contributors": [
		"Tellinq",
		"MicrocontrollersDev",
		"Wyvest"
	],
	"contact": {
		"sources": "${source}",
		"issues": "${issues}"
	},
	"license": "${license}",
	"icon": "assets/${id}/icon.png",
	"accessWidener": "animatium.accesswidener",
	"environment": "client",
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version_range}",
		"fabric-networking-api-v1": "*",
		"fabric-command-api-v2": "*",
		"fabric-resource-loader-v0": "*",
		"fabric-language-kotlin": "*",
		"yet_another_config_lib_v3": "*"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/client/renderer/state/CameraRenderState": ["org/visuals/legacy/animatium/util/states/CameraUtilityRenderState"],
			"net/minecraft/client/renderer/state/level/CameraRenderState": ["org/visuals/legacy/animatium/util/states/CameraUtilityRenderState"],
			"net/minecraft/client/renderer/item/ItemStackRenderState": ["org/visuals/legacy/animatium/util/states/ItemUtilityRenderState"],
			"net/minecraft/client/renderer/entity/state/ArmedEntityRenderState": ["org/visuals/legacy/animatium/util/states/UtilityRenderState"],
			"net/minecraft/world/entity/Entity": ["org/visuals/legacy/animatium/util/states/ViewBobbingStorage"]
		},
		"modmenu": {
			"links": {
				"modmenu.discord": "${discord}",
				"modmenu.modrinth": "${modrinth}",
				"modmenu.curseforge": "${curseforge}"
			},
			"update_checker": true
		}
	}
}
